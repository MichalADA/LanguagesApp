# Docker Compose development settings. Copy this file to .env.
NODE_ENV=development
POSTGRES_USER=lexo
POSTGRES_PASSWORD=lexo
POSTGRES_DB=lexodromia

# Generate different production secrets with: openssl rand -base64 48
JWT_SECRET=development-access-secret-change-before-production
JWT_REFRESH_SECRET=development-refresh-secret-change-before-production
JWT_ACCESS_EXPIRATION=15m
JWT_REFRESH_EXPIRATION=30d

AUTH_COOKIE_NAME=lexodromia_refresh
AUTH_COOKIE_SECURE=false
AUTH_REFRESH_COOKIE_MAX_AGE_MS=2592000000
CORS_ORIGIN=http://localhost:5173,http://localhost:8080
