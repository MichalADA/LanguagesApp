# --- Application ---
NODE_ENV=development
PORT=3000

# --- Database ---
# Local host use: postgresql://lexo:lexo@localhost:5432/lexodromia?schema=public
# Docker compose:  postgresql://lexo:lexo@postgres:5432/lexodromia?schema=public
DATABASE_URL=postgresql://lexo:lexo@localhost:5432/lexodromia?schema=public

# --- Auth ---
# Replace these with long random strings in production. Never commit real secrets.
JWT_SECRET=change-me-access-secret
JWT_ACCESS_EXPIRATION=15m
JWT_REFRESH_SECRET=change-me-refresh-secret
JWT_REFRESH_EXPIRATION=30d

BCRYPT_SALT_ROUNDS=12

# --- CORS ---
# Comma-separated list of allowed origins for the frontend.
CORS_ORIGIN=http://localhost:5173,http://localhost:8080
