    "react-router-dom": "^6.26.2"
  },
  "devDependencies": {
    "@types/react": "^18.3.10",
    "@types/react-dom": "^18.3.0",
    "@vitejs/plugin-react": "^4.3.1",
    "react-test-renderer": "^18.3.1",
    "typescript": "^5.6.2",
    "vite": "^5.4.8"
  }
}
