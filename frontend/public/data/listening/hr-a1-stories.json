      "titlePl": "Moje życie",
      "titleEn": "My life",
      "topic": "o sobie i rodzinie",
      "reviewStatus": "needs-native-review",
      "lines": [
        {
          "speaker": "marko",
          "textHr": "Zdravo! Zovem se Marko Horvat.",
          "textPl": "Cześć! Nazywam się Marko Horvat.",
          "audioPath": "/audio/listening/hr-a1/stories/a1-moj-zivot/01-marko.mp3"
        },
        {
          "speaker": "marko",
          "textHr": "Imam trideset pet godina. Ja sam iz Hrvatske.",
          "textPl": "Mam trzydzieści pięć lat. Jestem z Chorwacji.",
          "audioPath": "/audio/listening/hr-a1/stories/a1-moj-zivot/02-marko.mp3"
        },
        {
          "speaker": "marko",
          "textHr": "Živim u Zagrebu, u malom stanu u centru grada.",
          "textPl": "Mieszkam w Zagrzebiu, w małym mieszkaniu w centrum miasta.",
          "audioPath": "/audio/listening/hr-a1/stories/a1-moj-zivot/03-marko.mp3"
        },
        {
          "speaker": "marko",
          "textHr": "Stan ima dvije sobe, kuhinju i kupaonicu.",
          "textPl": "Mieszkanie ma dwa pokoje, kuchnię i łazienkę.",
          "audioPath": "/audio/listening/hr-a1/stories/a1-moj-zivot/04-marko.mp3"
        },
        {
          "speaker": "marko",
          "textHr": "Oženjen sam. Moja žena se zove Ana.",
          "textPl": "Jestem żonaty. Moja żona ma na imię Ana.",
          "audioPath": "/audio/listening/hr-a1/stories/a1-moj-zivot/05-marko.mp3"
        },
        {
          "speaker": "marko",
          "textHr": "Ona ima trideset dvije godine. Ana je učiteljica i radi u školi.",
          "textPl": "Ma trzydzieści dwa lata. Ana jest nauczycielką i pracuje w szkole.",
          "audioPath": "/audio/listening/hr-a1/stories/a1-moj-zivot/06-marko.mp3"
        },
        {
          "speaker": "marko",
          "textHr": "Imamo jedno dijete, sina Luku. Luka ima pet godina.",
          "textPl": "Mamy jedno dziecko, syna Lukę. Luka ma pięć lat.",
          "audioPath": "/audio/listening/hr-a1/stories/a1-moj-zivot/07-marko.mp3"
        },
        {
          "speaker": "marko",
          "textHr": "Ja sam inženjer. Radim u velikoj firmi.",
          "textPl": "Jestem inżynierem. Pracuję w dużej firmie.",
          "audioPath": "/audio/listening/hr-a1/stories/a1-moj-zivot/08-marko.mp3"
        },
        {
          "speaker": "marko",
          "textHr": "Svaki dan idem na posao tramvajem. Radim od osam do četiri.",
          "textPl": "Codziennie jeżdżę do pracy tramwajem. Pracuję od ósmej do czwartej.",
          "audioPath": "/audio/listening/hr-a1/stories/a1-moj-zivot/09-marko.mp3"
        },
        {
          "speaker": "marko",
          "textHr": "U slobodno vrijeme volim čitati knjige i gledati nogomet.",
          "textPl": "W wolnym czasie lubię czytać książki i oglądać piłkę nożną.",
          "audioPath": "/audio/listening/hr-a1/stories/a1-moj-zivot/10-marko.mp3"
        },
        {
          "speaker": "marko",
          "textHr": "Vikendom idemo u park ili kod mojih roditelja.",
          "textPl": "W weekendy chodzimy do parku albo do moich rodziców.",
