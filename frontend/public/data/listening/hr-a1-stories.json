      "lines": [
        {
          "speaker": "jelena",
          "textHr": "Dobar dan! Ja sam Jelena Kovač.",
          "textPl": "Dzień dobry! Jestem Jelena Kovač.",
          "audioPath": "/audio/listening/hr-a1/stories/a1-moj-dan/01-jelena.mp3"
        },
        {
          "speaker": "jelena",
          "textHr": "Imam četrdeset dvije godine i živim u Osijeku.",
          "textPl": "Mam czterdzieści dwa lata i mieszkam w Osijeku.",
          "audioPath": "/audio/listening/hr-a1/stories/a1-moj-dan/02-jelena.mp3"
        },
        {
          "speaker": "jelena",
          "textHr": "Osijek je grad na istoku Hrvatske, na rijeci Dravi.",
          "textPl": "Osijek to miasto na wschodzie Chorwacji, nad rzeką Drawą.",
          "audioPath": "/audio/listening/hr-a1/stories/a1-moj-dan/03-jelena.mp3"
        },
        {
          "speaker": "jelena",
          "textHr": "Ja sam medicinska sestra. Radim u bolnici.",
          "textPl": "Jestem pielęgniarką. Pracuję w szpitalu.",
          "audioPath": "/audio/listening/hr-a1/stories/a1-moj-dan/04-jelena.mp3"
        },
        {
          "speaker": "jelena",
          "textHr": "Moj dan počinje rano. Ustajem u šest sati.",
          "textPl": "Mój dzień zaczyna się wcześnie. Wstaję o szóstej.",
          "audioPath": "/audio/listening/hr-a1/stories/a1-moj-dan/05-jelena.mp3"
        },
        {
          "speaker": "jelena",
          "textHr": "Za doručak jedem kruh sa sirom i pijem čaj.",
          "textPl": "Na śniadanie jem chleb z serem i piję herbatę.",
          "audioPath": "/audio/listening/hr-a1/stories/a1-moj-dan/06-jelena.mp3"
        },
        {
          "speaker": "jelena",
          "textHr": "Na posao idem biciklom. Bolnica nije daleko.",
          "textPl": "Do pracy jeżdżę rowerem. Szpital nie jest daleko.",
          "audioPath": "/audio/listening/hr-a1/stories/a1-moj-dan/07-jelena.mp3"
        },
        {
          "speaker": "jelena",
          "textHr": "Imam muža Ivana i dvije kćeri, Saru i Petru.",
          "textPl": "Mam męża Ivana i dwie córki, Sarę i Petrę.",
          "audioPath": "/audio/listening/hr-a1/stories/a1-moj-dan/08-jelena.mp3"
        },
        {
          "speaker": "jelena",
          "textHr": "Sara ima dvanaest godina, a Petra deset.",
          "textPl": "Sara ma dwanaście lat, a Petra dziesięć.",
          "audioPath": "/audio/listening/hr-a1/stories/a1-moj-dan/09-jelena.mp3"
        },
        {
          "speaker": "jelena",
          "textHr": "Imamo i psa. Zove se Medo.",
          "textPl": "Mamy też psa. Nazywa się Medo.",
          "audioPath": "/audio/listening/hr-a1/stories/a1-moj-dan/10-jelena.mp3"
        },
        {
          "speaker": "jelena",
          "textHr": "Navečer kuham večeru. Volim kuhati!",
          "textPl": "Wieczorem gotuję kolację. Lubię gotować!",
          "audioPath": "/audio/listening/hr-a1/stories/a1-moj-dan/11-jelena.mp3"
        },
        {
          "speaker": "jelena",
          "textHr": "Poslije večere šetam psa uz rijeku.",
          "textPl": "Po kolacji spaceruję z psem nad rzeką.",
          "audioPath": "/audio/listening/hr-a1/stories/a1-moj-dan/12-jelena.mp3"
        },
        {
          "speaker": "jelena",
          "textHr": "Ne volim zimu jer je hladno. Volim proljeće.",
          "textPl": "Nie lubię zimy, bo jest zimno. Lubię wiosnę.",
          "audioPath": "/audio/listening/hr-a1/stories/a1-moj-dan/13-jelena.mp3"
        },
        {
          "speaker": "jelena",
          "textHr": "U deset sati idem spavati. Laku noć!",
          "textPl": "O dziesiątej idę spać. Dobranoc!",
          "audioPath": "/audio/listening/hr-a1/stories/a1-moj-dan/14-jelena.mp3"
        }
