      "text": "katamaran",
      "voice": "eqAqnItEUARzEkoDCTJ1",
      "rate": "-8%",
      "audioPath": "/audio/hr/stories/dubrovnik-b1/elevenlabs/player/katamaran.mp3"
    },
    {
      "speaker": "player",
      "text": "klijent",
      "voice": "eqAqnItEUARzEkoDCTJ1",
      "rate": "-8%",
      "audioPath": "/audio/hr/stories/dubrovnik-b1/elevenlabs/player/klijent.mp3"
    },
    {
      "speaker": "player",
      "text": "Koliko košta izlet po osobi?",
      "voice": "eqAqnItEUARzEkoDCTJ1",
      "rate": "-8%",
      "audioPath": "/audio/hr/stories/dubrovnik-b1/elevenlabs/player/koliko-kosta-izlet-po-osobi.mp3"
    },
    {
      "speaker": "player",
      "text": "luka",
      "voice": "eqAqnItEUARzEkoDCTJ1",
      "rate": "-8%",
      "audioPath": "/audio/hr/stories/dubrovnik-b1/elevenlabs/player/luka.mp3"
    },
    {
      "speaker": "player",
      "text": "Ma, to je bio timski rad. Bez vas ne bi uspjelo.",
      "voice": "eqAqnItEUARzEkoDCTJ1",
      "rate": "-8%",
      "audioPath": "/audio/hr/stories/dubrovnik-b1/elevenlabs/player/ma-to-je-bio-timski-rad-bez-vas-ne-bi-uspjelo.mp3"
    },
    {
      "speaker": "player",
      "text": "Mislim da je bolje živjeti ovdje, jer je more blizu.",
      "voice": "eqAqnItEUARzEkoDCTJ1",
      "rate": "-8%",
      "audioPath": "/audio/hr/stories/dubrovnik-b1/elevenlabs/player/mislim-da-je-bolje-zivjeti-ovdje-jer-je-more-blizu.mp3"
    },
    {
      "speaker": "player",
      "text": "Mislim da ne. Iako smo skuplji, imamo bolje vodiče.",
      "voice": "eqAqnItEUARzEkoDCTJ1",
      "rate": "-8%",
      "audioPath": "/audio/hr/stories/dubrovnik-b1/elevenlabs/player/mislim-da-ne-iako-smo-skuplji-imamo-bolje-vodice.mp3"
    },
    {
      "speaker": "player",
      "text": "Mogu ja pripremiti prezentaciju do četvrtka.",
      "voice": "eqAqnItEUARzEkoDCTJ1",
      "rate": "-8%",
      "audioPath": "/audio/hr/stories/dubrovnik-b1/elevenlabs/player/mogu-ja-pripremiti-prezentaciju-do-cetvrtka.mp3"
    },
    {
      "speaker": "player",
      "text": "Moram stići do Pila prije nego što padne mrak.",
      "voice": "eqAqnItEUARzEkoDCTJ1",
      "rate": "-8%",
      "audioPath": "/audio/hr/stories/dubrovnik-b1/elevenlabs/player/moram-stici-do-pila-prije-nego-sto-padne-mrak.mp3"
    },
    {
      "speaker": "player",
      "text": "Možda ima karata na blagajni.",
      "voice": "eqAqnItEUARzEkoDCTJ1",
      "rate": "-8%",
      "audioPath": "/audio/hr/stories/dubrovnik-b1/elevenlabs/player/mozda-ima-karata-na-blagajni.mp3"
    },
    {
      "speaker": "player",
      "text": "Može, ali ne prerano. Kako bi bilo da se nađemo u devet?",
      "voice": "eqAqnItEUARzEkoDCTJ1",
      "rate": "-8%",
      "audioPath": "/audio/hr/stories/dubrovnik-b1/elevenlabs/player/moze-ali-ne-prerano-kako-bi-bilo-da-se-nadjemo-u-devet.mp3"
    },
    {
      "speaker": "player",
      "text": "Može. Kako bi bilo da se nađemo jučer u devet?",
      "voice": "eqAqnItEUARzEkoDCTJ1",
      "rate": "-8%",
      "audioPath": "/audio/hr/stories/dubrovnik-b1/elevenlabs/player/moze-kako-bi-bilo-da-se-nadjemo-jucer-u-devet.mp3"
    },
    {
      "speaker": "player",
      "text": "Možete li mi to potvrditi pismeno?",
      "voice": "eqAqnItEUARzEkoDCTJ1",
      "rate": "-8%",
      "audioPath": "/audio/hr/stories/dubrovnik-b1/elevenlabs/player/mozete-li-mi-to-potvrditi-pismeno.mp3"
    },
    {
      "speaker": "player",
      "text": "Naravno, bez mene vi niste ništa.",
      "voice": "eqAqnItEUARzEkoDCTJ1",
      "rate": "-8%",
      "audioPath": "/audio/hr/stories/dubrovnik-b1/elevenlabs/player/naravno-bez-mene-vi-niste-nista.mp3"
    },
    {
      "speaker": "player",
      "text": "Naravno! Pisali smo si i vidjeli smo se.",
      "voice": "eqAqnItEUARzEkoDCTJ1",
      "rate": "-8%",
      "audioPath": "/audio/hr/stories/dubrovnik-b1/elevenlabs/player/naravno-pisali-smo-si-i-vidjeli-smo-se.mp3"
    },
    {
      "speaker": "player",
      "text": "Naravno! Pisat ćemo si i opet ćemo se vidjeti.",
      "voice": "eqAqnItEUARzEkoDCTJ1",
      "rate": "-8%",
      "audioPath": "/audio/hr/stories/dubrovnik-b1/elevenlabs/player/naravno-pisat-cemo-si-i-opet-cemo-se-vidjeti.mp3"
    },
    {
      "speaker": "player",
      "text": "navodno",
      "voice": "eqAqnItEUARzEkoDCTJ1",
      "rate": "-8%",
      "audioPath": "/audio/hr/stories/dubrovnik-b1/elevenlabs/player/navodno.mp3"
    },
    {
      "speaker": "player",
      "text": "Nažalost, nije. Kupaonica je jako čista i svijetla.",
      "voice": "eqAqnItEUARzEkoDCTJ1",
      "rate": "-8%",
      "audioPath": "/audio/hr/stories/dubrovnik-b1/elevenlabs/player/nazalost-nije-kupaonica-je-jako-cista-i-svijetla.mp3"
    },
    {
      "speaker": "player",
      "text": "Nažalost, nije. U kupaonici je plijesan, a odvod je začepljen.",
      "voice": "eqAqnItEUARzEkoDCTJ1",
      "rate": "-8%",
      "audioPath": "/audio/hr/stories/dubrovnik-b1/elevenlabs/player/nazalost-nije-u-kupaonici-je-plijesan-a-odvod-je-zacepljen.mp3"
    },
    {
      "speaker": "player",
      "text": "Ne znam ništa o tome. Što se događa?",
      "voice": "eqAqnItEUARzEkoDCTJ1",
      "rate": "-8%",
      "audioPath": "/audio/hr/stories/dubrovnik-b1/elevenlabs/player/ne-znam-nista-o-tome-sto-se-dogadja.mp3"
    },
    {
      "speaker": "player",
      "text": "Ne. Dajte mi stanicu!",
      "voice": "eqAqnItEUARzEkoDCTJ1",
      "rate": "-8%",
      "audioPath": "/audio/hr/stories/dubrovnik-b1/elevenlabs/player/ne-dajte-mi-stanicu.mp3"
    },
    {
      "speaker": "player",
      "text": "Nema problema, poslat ću ga prekjučer.",
      "voice": "eqAqnItEUARzEkoDCTJ1",
      "rate": "-8%",
      "audioPath": "/audio/hr/stories/dubrovnik-b1/elevenlabs/player/nema-problema-poslat-cu-ga-prekjucer.mp3"
    },
    {
      "speaker": "player",
      "text": "Nema problema, poslat ću ga svima do podneva.",
      "voice": "eqAqnItEUARzEkoDCTJ1",
      "rate": "-8%",
      "audioPath": "/audio/hr/stories/dubrovnik-b1/elevenlabs/player/nema-problema-poslat-cu-ga-svima-do-podneva.mp3"
    },
    {
      "speaker": "player",
      "text": "Nemam vremena, idem na pauzu.",
      "voice": "eqAqnItEUARzEkoDCTJ1",
      "rate": "-8%",
      "audioPath": "/audio/hr/stories/dubrovnik-b1/elevenlabs/player/nemam-vremena-idem-na-pauzu.mp3"
    },
    {
      "speaker": "player",
      "text": "nemojte",
      "voice": "eqAqnItEUARzEkoDCTJ1",
      "rate": "-8%",
      "audioPath": "/audio/hr/stories/dubrovnik-b1/elevenlabs/player/nemojte.mp3"
    },
    {
      "speaker": "player",
      "text": "Nevjerojatno. Nikad neću zaboraviti Dubrovnik.",
      "voice": "eqAqnItEUARzEkoDCTJ1",
      "rate": "-8%",
      "audioPath": "/audio/hr/stories/dubrovnik-b1/elevenlabs/player/nevjerojatno-nikad-necu-zaboraviti-dubrovnik.mp3"
    },
    {
      "speaker": "player",
      "text": "Nevjerojatno. Zaboravit ću Dubrovnik već sutra.",
      "voice": "eqAqnItEUARzEkoDCTJ1",
      "rate": "-8%",
      "audioPath": "/audio/hr/stories/dubrovnik-b1/elevenlabs/player/nevjerojatno-zaboravit-cu-dubrovnik-vec-sutra.mp3"
