{
  "provider": "elevenlabs",
  "model": "eleven_multilingual_v2",
  "rate": "-8%",
  "story": "dubrovnik-b1",
  "items": [
    {
      "speaker": "ante",
      "text": "Ajme, polako! Može to i malo ljubaznije.",
      "voice": "peXmQaCErbfrWCM5FqjH",
      "rate": "-8%",
      "audioPath": "/audio/hr/stories/dubrovnik-b1/elevenlabs/ante/ajme-polako-moze-to-i-malo-ljubaznije.mp3"
    },
    {
      "speaker": "ante",
      "text": "Dobar dan! Taksi? Do Staroga grada je petnaest eura.",
      "voice": "peXmQaCErbfrWCM5FqjH",
      "rate": "-8%",
      "audioPath": "/audio/hr/stories/dubrovnik-b1/elevenlabs/ante/dobar-dan-taksi-do-staroga-grada-je-petnaest-eura.mp3"
    },
    {
      "speaker": "ante",
      "text": "Dobar izbor! Javite mi broj gostiju do petka.",
      "voice": "peXmQaCErbfrWCM5FqjH",
      "rate": "-8%",
      "audioPath": "/audio/hr/stories/dubrovnik-b1/elevenlabs/ante/dobar-izbor-javite-mi-broj-gostiju-do-petka.mp3"
    },
    {
      "speaker": "ante",
      "text": "Dobar? Oba su dobra! Ali što je bolje?",
      "voice": "peXmQaCErbfrWCM5FqjH",
      "rate": "-8%",
      "audioPath": "/audio/hr/stories/dubrovnik-b1/elevenlabs/ante/dobar-oba-su-dobra-ali-sto-je-bolje.mp3"
    },
    {
      "speaker": "ante",
      "text": "Dogovoreno! Dobro došli u Dubrovnik!",
      "voice": "peXmQaCErbfrWCM5FqjH",
      "rate": "-8%",
      "audioPath": "/audio/hr/stories/dubrovnik-b1/elevenlabs/ante/dogovoreno-dobro-dosli-u-dubrovnik.mp3"
    },
    {
      "speaker": "ante",
      "text": "Lokrum je bliži — samo deset minuta brodom — i jeftiniji. Ali Elafiti su mirniji i imaju ljepše plaže.",
      "voice": "peXmQaCErbfrWCM5FqjH",
      "rate": "-8%",
      "audioPath": "/audio/hr/stories/dubrovnik-b1/elevenlabs/ante/lokrum-je-blizi-samo-deset-minuta-brodom-i-jeftiniji-ali-ela.mp3"
    },
    {
      "speaker": "ante",
      "text": "Lokrum je petnaest eura, Elafiti pedeset, ali s ručkom. Izvan sezone je sve dvadeset posto jeftinije.",
      "voice": "peXmQaCErbfrWCM5FqjH",
      "rate": "-8%",
      "audioPath": "/audio/hr/stories/dubrovnik-b1/elevenlabs/ante/lokrum-je-petnaest-eura-elafiti-pedeset-ali-s-ruckom-izvan-s.mp3"
    },
    {
      "speaker": "ante",
      "text": "Molim? Cijena po osobi?",
      "voice": "peXmQaCErbfrWCM5FqjH",
      "rate": "-8%",
      "audioPath": "/audio/hr/stories/dubrovnik-b1/elevenlabs/ante/molim-cijena-po-osobi.mp3"
    },
    {
      "speaker": "ante",
      "text": "Molim? Do Pila — kada?",
      "voice": "peXmQaCErbfrWCM5FqjH",
      "rate": "-8%",
      "audioPath": "/audio/hr/stories/dubrovnik-b1/elevenlabs/ante/molim-do-pila-kada.mp3"
    },
    {
      "speaker": "ante",
      "text": "Naravno. Stanica je odmah preko ceste. Do Pila voze jedinica, sedmica i osmica, a karta kod vozača je skuplja nego na kiosku.",
      "voice": "peXmQaCErbfrWCM5FqjH",
      "rate": "-8%",
      "audioPath": "/audio/hr/stories/dubrovnik-b1/elevenlabs/ante/naravno-stanica-je-odmah-preko-ceste-do-pila-voze-jedinica-s.mp3"
    },
    {
      "speaker": "ante",
      "text": "Ne, ne — jedinica, sedmica ili osmica. Karta je jeftinija na kiosku.",
      "voice": "peXmQaCErbfrWCM5FqjH",
      "rate": "-8%",
      "audioPath": "/audio/hr/stories/dubrovnik-b1/elevenlabs/ante/ne-ne-jedinica-sedmica-ili-osmica-karta-je-jeftinija-na-kios.mp3"
    },
    {
      "speaker": "ante",
      "text": "Ne, ne — Lokrum je bliži i jeftiniji!",
      "voice": "peXmQaCErbfrWCM5FqjH",
      "rate": "-8%",
      "audioPath": "/audio/hr/stories/dubrovnik-b1/elevenlabs/ante/ne-ne-lokrum-je-blizi-i-jeftiniji.mp3"
    },
    {
      "speaker": "ante",
      "text": "Onda požurite! Sljedeći autobus polazi za pet minuta, a idući tek za pola sata.",
      "voice": "peXmQaCErbfrWCM5FqjH",
      "rate": "-8%",
      "audioPath": "/audio/hr/stories/dubrovnik-b1/elevenlabs/ante/onda-pozurite-sljedeci-autobus-polazi-za-pet-minuta-a-iduci.mp3"
    },
    {
      "speaker": "ante",
      "text": "Opet vi! Čujem da tražite izlet za goste. Lokrum ili Elafiti?",
      "voice": "peXmQaCErbfrWCM5FqjH",
      "rate": "-8%",
      "audioPath": "/audio/hr/stories/dubrovnik-b1/elevenlabs/ante/opet-vi-cujem-da-trazite-izlet-za-goste-lokrum-ili-elafiti.mp3"
    },
    {
      "speaker": "ante",
      "text": "Pedeset? Ne — pet minuta! Požurite!",
      "voice": "peXmQaCErbfrWCM5FqjH",
      "rate": "-8%",
      "audioPath": "/audio/hr/stories/dubrovnik-b1/elevenlabs/ante/pedeset-ne-pet-minuta-pozurite.mp3"
    },
    {
      "speaker": "ante",
      "text": "Prošlog petka? To je bilo prije tjedan dana!",
      "voice": "peXmQaCErbfrWCM5FqjH",
      "rate": "-8%",
      "audioPath": "/audio/hr/stories/dubrovnik-b1/elevenlabs/ante/proslog-petka-to-je-bilo-prije-tjedan-dana.mp3"
    },
    {
      "speaker": "ante",
      "text": "Tako je. A kamo točno idete? Uskoro će pasti mrak.",
      "voice": "peXmQaCErbfrWCM5FqjH",
      "rate": "-8%",
      "audioPath": "/audio/hr/stories/dubrovnik-b1/elevenlabs/ante/tako-je-a-kamo-tocno-idete-uskoro-ce-pasti-mrak.mp3"
    },
    {
      "speaker": "ante",
      "text": "Točno. Izlet na Elafite traje cijeli dan, s ručkom na brodu.",
      "voice": "peXmQaCErbfrWCM5FqjH",
      "rate": "-8%",
      "audioPath": "/audio/hr/stories/dubrovnik-b1/elevenlabs/ante/tocno-izlet-na-elafite-traje-cijeli-dan-s-ruckom-na-brodu.mp3"
    },
    {
      "speaker": "ivo",
      "text": "A danas je poznat po serijama. Navodno ovdje svake godine dolazi više od milijun turista.",
      "voice": "DAGnQ7r9sMtV0Q44g1Mi",
      "rate": "-8%",
      "audioPath": "/audio/hr/stories/dubrovnik-b1/elevenlabs/ivo/a-danas-je-poznat-po-serijama-navodno-ovdje-svake-godine-dol.mp3"
    },
    {
      "speaker": "ivo",
      "text": "Dobro došli na zidine! Izgrađene su uglavnom od trinaestog do sedamnaestog stoljeća.",
      "voice": "DAGnQ7r9sMtV0Q44g1Mi",
      "rate": "-8%",
      "audioPath": "/audio/hr/stories/dubrovnik-b1/elevenlabs/ivo/dobro-dosli-na-zidine-izgradjene-su-uglavnom-od-trinaestog-d.mp3"
    },
    {
      "speaker": "ivo",
      "text": "Istina je! Ali ja uvijek kažem: zidine su starije od svake serije. Ha-ha.",
      "voice": "DAGnQ7r9sMtV0Q44g1Mi",
      "rate": "-8%",
      "audioPath": "/audio/hr/stories/dubrovnik-b1/elevenlabs/ivo/istina-je-ali-ja-uvijek-kazem-zidine-su-starije-od-svake-ser.mp3"
    },
    {
      "speaker": "ivo",
      "text": "Lijepo rečeno. Hvala što ste bili s nama!",
      "voice": "DAGnQ7r9sMtV0Q44g1Mi",
      "rate": "-8%",
      "audioPath": "/audio/hr/stories/dubrovnik-b1/elevenlabs/ivo/lijepo-receno-hvala-sto-ste-bili-s-nama.mp3"
    },
    {
      "speaker": "ivo",
      "text": "Molim? Po čemu je bio poznat?",
      "voice": "DAGnQ7r9sMtV0Q44g1Mi",
      "rate": "-8%",
      "audioPath": "/audio/hr/stories/dubrovnik-b1/elevenlabs/ivo/molim-po-cemu-je-bio-poznat.mp3"
    },
    {
      "speaker": "ivo",
      "text": "Prazan? S milijun turista? Ha-ha, ne bih rekao!",
      "voice": "DAGnQ7r9sMtV0Q44g1Mi",
      "rate": "-8%",
      "audioPath": "/audio/hr/stories/dubrovnik-b1/elevenlabs/ivo/prazan-s-milijun-turista-ha-ha-ne-bih-rekao.mp3"
    },
    {
      "speaker": "ivo",
      "text": "Prošle godine? Ha-ha, ne — prije sedamsto godina!",
      "voice": "DAGnQ7r9sMtV0Q44g1Mi",
      "rate": "-8%",
      "audioPath": "/audio/hr/stories/dubrovnik-b1/elevenlabs/ivo/prosle-godine-ha-ha-ne-prije-sedamsto-godina.mp3"
    },
    {
      "speaker": "ivo",
      "text": "Tako je. Dubrovnik je stoljećima bio slobodna republika. Bio je poznat po diplomaciji, a ne po vojsci.",
      "voice": "DAGnQ7r9sMtV0Q44g1Mi",
      "rate": "-8%",
      "audioPath": "/audio/hr/stories/dubrovnik-b1/elevenlabs/ivo/tako-je-dubrovnik-je-stoljecima-bio-slobodna-republika-bio-j.mp3"
    },
    {
      "speaker": "jelena",
      "text": "Dobar dan! Kako vam mogu pomoći?",
      "voice": "d3l4f3HgkE3P6Fo91lYA",
      "rate": "-8%",
      "audioPath": "/audio/hr/stories/dubrovnik-b1/elevenlabs/jelena/dobar-dan-kako-vam-mogu-pomoci.mp3"
    },
    {
      "speaker": "jelena",
      "text": "Joj, vidim. A nos? Imate li neku alergiju?",
      "voice": "d3l4f3HgkE3P6Fo91lYA",
      "rate": "-8%",
      "audioPath": "/audio/hr/stories/dubrovnik-b1/elevenlabs/jelena/joj-vidim-a-nos-imate-li-neku-alergiju.mp3"
    },
    {
      "speaker": "jelena",
      "text": "Molim? Na što ste alergični?",
      "voice": "d3l4f3HgkE3P6Fo91lYA",
      "rate": "-8%",
      "audioPath": "/audio/hr/stories/dubrovnik-b1/elevenlabs/jelena/molim-na-sto-ste-alergicni.mp3"
    },
    {
      "speaker": "jelena",
      "text": "Na plaži? Nemojte, molim vas! Odmor, voda, hlad.",
      "voice": "d3l4f3HgkE3P6Fo91lYA",
      "rate": "-8%",
      "audioPath": "/audio/hr/stories/dubrovnik-b1/elevenlabs/jelena/na-plazi-nemojte-molim-vas-odmor-voda-hlad.mp3"
    },
    {
      "speaker": "jelena",
      "text": "Ne — samo jednu, i to navečer.",
      "voice": "d3l4f3HgkE3P6Fo91lYA",
      "rate": "-8%",
      "audioPath": "/audio/hr/stories/dubrovnik-b1/elevenlabs/jelena/ne-samo-jednu-i-to-navecer.mp3"
    },
    {
      "speaker": "jelena",
      "text": "Nema na čemu. Brzo ozdravite!",
      "voice": "d3l4f3HgkE3P6Fo91lYA",
      "rate": "-8%",
      "audioPath": "/audio/hr/stories/dubrovnik-b1/elevenlabs/jelena/nema-na-cemu-brzo-ozdravite.mp3"
    },
    {
      "speaker": "jelena",
      "text": "Pijte puno vode i nemojte pretjerivati s kupanjem. Bilo bi dobro da tri dana mirujete.",
      "voice": "d3l4f3HgkE3P6Fo91lYA",
      "rate": "-8%",
      "audioPath": "/audio/hr/stories/dubrovnik-b1/elevenlabs/jelena/pijte-puno-vode-i-nemojte-pretjerivati-s-kupanjem-bilo-bi-do.mp3"
    },
    {
      "speaker": "jelena",
      "text": "Sunce? Ha-ha, sunce je dobro. Što je izgorjelo?",
      "voice": "d3l4f3HgkE3P6Fo91lYA",
      "rate": "-8%",
      "audioPath": "/audio/hr/stories/dubrovnik-b1/elevenlabs/jelena/sunce-ha-ha-sunce-je-dobro-sto-je-izgorjelo.mp3"
    },
    {
      "speaker": "jelena",
      "text": "Tako je. I nemojte biti na suncu između jedanaest i četiri.",
      "voice": "d3l4f3HgkE3P6Fo91lYA",
      "rate": "-8%",
      "audioPath": "/audio/hr/stories/dubrovnik-b1/elevenlabs/jelena/tako-je-i-nemojte-biti-na-suncu-izmedju-jedanaest-i-cetiri.mp3"
    },
    {
      "speaker": "jelena",
      "text": "Za leđa vam preporučujem ovaj gel, a za alergiju tablete. Uzimajte jednu dnevno, navečer, jer izazivaju umor.",
      "voice": "d3l4f3HgkE3P6Fo91lYA",
      "rate": "-8%",
      "audioPath": "/audio/hr/stories/dubrovnik-b1/elevenlabs/jelena/za-ledja-vam-preporucujem-ovaj-gel-a-za-alergiju-tablete-uzi.mp3"
    },
    {
      "speaker": "narrator",
      "text": "Agencija treba izlet za goste hotela. Ante, koji ima i brod, čeka u luci.",
      "voice": "fig0OacgTXhKNFpywQvp",
      "rate": "-8%",
      "audioPath": "/audio/hr/stories/dubrovnik-b1/elevenlabs/narrator/agencija-treba-izlet-za-goste-hotela-ante-koji-ima-i-brod-ce.mp3"
    },
    {
      "speaker": "narrator",
      "text": "Apartman u Starom gradu: kameni zidovi, pogled na krovove — i miris vlage.",
      "voice": "fig0OacgTXhKNFpywQvp",
      "rate": "-8%",
      "audioPath": "/audio/hr/stories/dubrovnik-b1/elevenlabs/narrator/apartman-u-starom-gradu-kameni-zidovi-pogled-na-krovove-i-mi.mp3"
    },
    {
      "speaker": "narrator",
      "text": "Gradske zidine. Gotovo dva kilometra kamena, a ispod — more i krovovi Staroga grada.",
      "voice": "fig0OacgTXhKNFpywQvp",
      "rate": "-8%",
      "audioPath": "/audio/hr/stories/dubrovnik-b1/elevenlabs/narrator/gradske-zidine-gotovo-dva-kilometra-kamena-a-ispod-more-i-kr.mp3"
    },
    {
      "speaker": "narrator",
      "text": "Ljekarna kod Pila. Vani je trideset i pet stupnjeva.",
      "voice": "fig0OacgTXhKNFpywQvp",
      "rate": "-8%",
      "audioPath": "/audio/hr/stories/dubrovnik-b1/elevenlabs/narrator/ljekarna-kod-pila-vani-je-trideset-i-pet-stupnjeva.mp3"
    },
    {
      "speaker": "narrator",
      "text": "Luka Gruž, kasno poslijepodne. Katamaran iz Splita upravo je pristao.",
      "voice": "fig0OacgTXhKNFpywQvp",
      "rate": "-8%",
      "audioPath": "/audio/hr/stories/dubrovnik-b1/elevenlabs/narrator/luka-gruz-kasno-poslijepodne-katamaran-iz-splita-upravo-je-p.mp3"
    },
    {
      "speaker": "narrator",
      "text": "Plaža Banje, zadnji dan ljeta. Sunce zalazi iza Lokruma.",
      "voice": "fig0OacgTXhKNFpywQvp",
      "rate": "-8%",
      "audioPath": "/audio/hr/stories/dubrovnik-b1/elevenlabs/narrator/plaza-banje-zadnji-dan-ljeta-sunce-zalazi-iza-lokruma.mp3"
    },
    {
      "speaker": "narrator",
      "text": "Sljedeće jutro, na blagajni: zadnje dvije karte!",
      "voice": "fig0OacgTXhKNFpywQvp",
      "rate": "-8%",
      "audioPath": "/audio/hr/stories/dubrovnik-b1/elevenlabs/narrator/sljedece-jutro-na-blagajni-zadnje-dvije-karte.mp3"
    },
    {
      "speaker": "narrator",
      "text": "Stradun navečer. Kamen je još topao, a s Luže se čuje glazba.",
      "voice": "fig0OacgTXhKNFpywQvp",
      "rate": "-8%",
      "audioPath": "/audio/hr/stories/dubrovnik-b1/elevenlabs/narrator/stradun-navecer-kamen-je-jos-topao-a-s-luze-se-cuje-glazba.mp3"
    },
    {
      "speaker": "narrator",
      "text": "Turistička agencija blizu Straduna. Ponedjeljak, devet sati: sastanak tima.",
      "voice": "fig0OacgTXhKNFpywQvp",
      "rate": "-8%",
      "audioPath": "/audio/hr/stories/dubrovnik-b1/elevenlabs/narrator/turisticka-agencija-blizu-straduna-ponedjeljak-devet-sati-sa.mp3"
    },
    {
      "speaker": "nikola",
      "text": "Danas je teško, nedjelja je… Ali dobro, nazvat ću susjeda, on je vodoinstalater.",
      "voice": "olecVpv03asgm9w2Vs6l",
      "rate": "-8%",
      "audioPath": "/audio/hr/stories/dubrovnik-b1/elevenlabs/nikola/danas-je-tesko-nedjelja-je-ali-dobro-nazvat-cu-susjeda-on-je.mp3"
    },
    {
      "speaker": "nikola",
      "text": "Dobra večer! Je li sve u redu s apartmanom?",
      "voice": "olecVpv03asgm9w2Vs6l",
      "rate": "-8%",
      "audioPath": "/audio/hr/stories/dubrovnik-b1/elevenlabs/nikola/dobra-vecer-je-li-sve-u-redu-s-apartmanom.mp3"
    },
    {
      "speaker": "nikola",
      "text": "Molim? Danas ili sutra?",
      "voice": "olecVpv03asgm9w2Vs6l",
      "rate": "-8%",
      "audioPath": "/audio/hr/stories/dubrovnik-b1/elevenlabs/nikola/molim-danas-ili-sutra.mp3"
    },
    {
      "speaker": "nikola",
      "text": "Naravno, plijesan je bila i prije. Jamčevinu ćete dobiti natrag u cijelosti.",
      "voice": "olecVpv03asgm9w2Vs6l",
      "rate": "-8%",
      "audioPath": "/audio/hr/stories/dubrovnik-b1/elevenlabs/nikola/naravno-plijesan-je-bila-i-prije-jamcevinu-cete-dobiti-natra.mp3"
    },
    {
      "speaker": "nikola",
      "text": "Naravno, poslat ću vam poruku večeras. Laku noć!",
      "voice": "olecVpv03asgm9w2Vs6l",
      "rate": "-8%",
      "audioPath": "/audio/hr/stories/dubrovnik-b1/elevenlabs/nikola/naravno-poslat-cu-vam-poruku-veceras-laku-noc.mp3"
    },
    {
      "speaker": "nikola",
      "text": "Pa onda je sve u redu? Ne razumijem.",
      "voice": "olecVpv03asgm9w2Vs6l",
      "rate": "-8%",
      "audioPath": "/audio/hr/stories/dubrovnik-b1/elevenlabs/nikola/pa-onda-je-sve-u-redu-ne-razumijem.mp3"
    },
    {
      "speaker": "nikola",
      "text": "Plijesan? Joj… To je zbog vlage, kuća je stara. Odvod ću popraviti sutra ili prekosutra.",
      "voice": "olecVpv03asgm9w2Vs6l",
      "rate": "-8%",
      "audioPath": "/audio/hr/stories/dubrovnik-b1/elevenlabs/nikola/plijesan-joj-to-je-zbog-vlage-kuca-je-stara-odvod-cu-popravi.mp3"
    },
    {
      "speaker": "nikola",
      "text": "Vaša? Ma ne, bila je tu i prije vas!",
      "voice": "olecVpv03asgm9w2Vs6l",
      "rate": "-8%",
      "audioPath": "/audio/hr/stories/dubrovnik-b1/elevenlabs/nikola/vasa-ma-ne-bila-je-tu-i-prije-vas.mp3"
    },
    {
      "speaker": "player",
      "text": "Ako sve bude dobro, vratit ću se sljedećeg ljeta.",
      "voice": "eqAqnItEUARzEkoDCTJ1",
      "rate": "-8%",
      "audioPath": "/audio/hr/stories/dubrovnik-b1/elevenlabs/player/ako-sve-bude-dobro-vratit-cu-se-sljedeceg-ljeta.mp3"
    },
    {
      "speaker": "player",
      "text": "alergija",
      "voice": "eqAqnItEUARzEkoDCTJ1",
      "rate": "-8%",
      "audioPath": "/audio/hr/stories/dubrovnik-b1/elevenlabs/player/alergija.mp3"
    },
    {
      "speaker": "player",
      "text": "argument",
      "voice": "eqAqnItEUARzEkoDCTJ1",
      "rate": "-8%",
      "audioPath": "/audio/hr/stories/dubrovnik-b1/elevenlabs/player/argument.mp3"
    },
    {
      "speaker": "player",
      "text": "bilo bi dobro da",
      "voice": "eqAqnItEUARzEkoDCTJ1",
      "rate": "-8%",
      "audioPath": "/audio/hr/stories/dubrovnik-b1/elevenlabs/player/bilo-bi-dobro-da.mp3"
    },
    {
      "speaker": "player",
      "text": "bilo bi super",
      "voice": "eqAqnItEUARzEkoDCTJ1",
      "rate": "-8%",
      "audioPath": "/audio/hr/stories/dubrovnik-b1/elevenlabs/player/bilo-bi-super.mp3"
    },
    {
      "speaker": "player",
      "text": "Biste li mogli poslati majstora još danas?",
      "voice": "eqAqnItEUARzEkoDCTJ1",
      "rate": "-8%",
      "audioPath": "/audio/hr/stories/dubrovnik-b1/elevenlabs/player/biste-li-mogli-poslati-majstora-jos-danas.mp3"
    },
    {
      "speaker": "player",
      "text": "blagajna",
      "voice": "eqAqnItEUARzEkoDCTJ1",
      "rate": "-8%",
      "audioPath": "/audio/hr/stories/dubrovnik-b1/elevenlabs/player/blagajna.mp3"
    },
    {
      "speaker": "player",
      "text": "budućnost",
      "voice": "eqAqnItEUARzEkoDCTJ1",
      "rate": "-8%",
      "audioPath": "/audio/hr/stories/dubrovnik-b1/elevenlabs/player/buducnost.mp3"
    },
    {
      "speaker": "player",
      "text": "curi mi nos",
      "voice": "eqAqnItEUARzEkoDCTJ1",
      "rate": "-8%",
      "audioPath": "/audio/hr/stories/dubrovnik-b1/elevenlabs/player/curi-mi-nos.mp3"
    },
    {
      "speaker": "player",
      "text": "Da, festival je bio prošle godine.",
      "voice": "eqAqnItEUARzEkoDCTJ1",
      "rate": "-8%",
      "audioPath": "/audio/hr/stories/dubrovnik-b1/elevenlabs/player/da-festival-je-bio-prosle-godine.mp3"
    },
    {
      "speaker": "player",
      "text": "Da, jer je kvaliteta skupa i zato loša.",
      "voice": "eqAqnItEUARzEkoDCTJ1",
      "rate": "-8%",
      "audioPath": "/audio/hr/stories/dubrovnik-b1/elevenlabs/player/da-jer-je-kvaliteta-skupa-i-zato-losa.mp3"
    },
    {
      "speaker": "player",
      "text": "Da, piše o tome na gradskom portalu. Ima li još karata?",
      "voice": "eqAqnItEUARzEkoDCTJ1",
      "rate": "-8%",
      "audioPath": "/audio/hr/stories/dubrovnik-b1/elevenlabs/player/da-pise-o-tome-na-gradskom-portalu-ima-li-jos-karata.mp3"
    },
    {
      "speaker": "player",
      "text": "događaj",
      "voice": "eqAqnItEUARzEkoDCTJ1",
      "rate": "-8%",
      "audioPath": "/audio/hr/stories/dubrovnik-b1/elevenlabs/player/dogadjaj.mp3"
    },
    {
      "speaker": "player",
      "text": "Dubrovnik je bio poznat po diplomaciji.",
      "voice": "eqAqnItEUARzEkoDCTJ1",
      "rate": "-8%",
      "audioPath": "/audio/hr/stories/dubrovnik-b1/elevenlabs/player/dubrovnik-je-bio-poznat-po-diplomaciji.mp3"
    },
    {
      "speaker": "player",
      "text": "Hvala, ali radije ću ići autobusom. Biste li mi mogli reći gdje je stanica?",
      "voice": "eqAqnItEUARzEkoDCTJ1",
      "rate": "-8%",
      "audioPath": "/audio/hr/stories/dubrovnik-b1/elevenlabs/player/hvala-ali-radije-cu-ici-autobusom-biste-li-mi-mogli-reci-gdj.mp3"
    },
    {
      "speaker": "player",
      "text": "Hvala! Ako mi bude trebao taksi, nazvat ću vas.",
      "voice": "eqAqnItEUARzEkoDCTJ1",
      "rate": "-8%",
      "audioPath": "/audio/hr/stories/dubrovnik-b1/elevenlabs/player/hvala-ako-mi-bude-trebao-taksi-nazvat-cu-vas.mp3"
    },
    {
      "speaker": "player",
      "text": "Hvala. Ali molim vas, zapišite da plijesan nije moja krivnja.",
      "voice": "eqAqnItEUARzEkoDCTJ1",
      "rate": "-8%",
      "audioPath": "/audio/hr/stories/dubrovnik-b1/elevenlabs/player/hvala-ali-molim-vas-zapisite-da-plijesan-nije-moja-krivnja.mp3"
    },
    {
      "speaker": "player",
      "text": "Hvala. Plijesan je moja krivnja.",
      "voice": "eqAqnItEUARzEkoDCTJ1",
      "rate": "-8%",
      "audioPath": "/audio/hr/stories/dubrovnik-b1/elevenlabs/player/hvala-plijesan-je-moja-krivnja.mp3"
    },
    {
      "speaker": "player",
      "text": "iako",
      "voice": "eqAqnItEUARzEkoDCTJ1",
      "rate": "-8%",
      "audioPath": "/audio/hr/stories/dubrovnik-b1/elevenlabs/player/iako.mp3"
    },
    {
      "speaker": "player",
      "text": "Iako ima puno turista, vrijedi pogledati.",
      "voice": "eqAqnItEUARzEkoDCTJ1",
      "rate": "-8%",
      "audioPath": "/audio/hr/stories/dubrovnik-b1/elevenlabs/player/iako-ima-puno-turista-vrijedi-pogledati.mp3"
    },
    {
      "speaker": "player",
      "text": "Iako ima puno turista, zato je grad prazan.",
      "voice": "eqAqnItEUARzEkoDCTJ1",
      "rate": "-8%",
      "audioPath": "/audio/hr/stories/dubrovnik-b1/elevenlabs/player/iako-ima-puno-turista-zato-je-grad-prazan.mp3"
    },
    {
      "speaker": "player",
      "text": "Imam alergiju na pelud.",
      "voice": "eqAqnItEUARzEkoDCTJ1",
      "rate": "-8%",
      "audioPath": "/audio/hr/stories/dubrovnik-b1/elevenlabs/player/imam-alergiju-na-pelud.mp3"
    },
    {
      "speaker": "player",
      "text": "Imate li još neki savjet?",
      "voice": "eqAqnItEUARzEkoDCTJ1",
      "rate": "-8%",
      "audioPath": "/audio/hr/stories/dubrovnik-b1/elevenlabs/player/imate-li-jos-neki-savjet.mp3"
    },
    {
      "speaker": "player",
      "text": "izbor",
      "voice": "eqAqnItEUARzEkoDCTJ1",
      "rate": "-8%",
      "audioPath": "/audio/hr/stories/dubrovnik-b1/elevenlabs/player/izbor.mp3"
    },
    {
      "speaker": "player",
      "text": "Izgorjela su mi leđa na suncu, a i curi mi nos.",
      "voice": "eqAqnItEUARzEkoDCTJ1",
      "rate": "-8%",
      "audioPath": "/audio/hr/stories/dubrovnik-b1/elevenlabs/player/izgorjela-su-mi-ledja-na-suncu-a-i-curi-mi-nos.mp3"
    },
    {
      "speaker": "player",
      "text": "Izgorjelo mi je sunce.",
      "voice": "eqAqnItEUARzEkoDCTJ1",
      "rate": "-8%",
      "audioPath": "/audio/hr/stories/dubrovnik-b1/elevenlabs/player/izgorjelo-mi-je-sunce.mp3"
    },
    {
      "speaker": "player",
      "text": "izgraditi",
      "voice": "eqAqnItEUARzEkoDCTJ1",
      "rate": "-8%",
      "audioPath": "/audio/hr/stories/dubrovnik-b1/elevenlabs/player/izgraditi.mp3"
    },
    {
      "speaker": "player",
      "text": "izvan sezone",
      "voice": "eqAqnItEUARzEkoDCTJ1",
      "rate": "-8%",
      "audioPath": "/audio/hr/stories/dubrovnik-b1/elevenlabs/player/izvan-sezone.mp3"
    },
    {
      "speaker": "player",
      "text": "jamčevina",
      "voice": "eqAqnItEUARzEkoDCTJ1",
      "rate": "-8%",
      "audioPath": "/audio/hr/stories/dubrovnik-b1/elevenlabs/player/jamcevina.mp3"
    },
    {
      "speaker": "player",
      "text": "Javit ću vam do petka. Hvala!",
      "voice": "eqAqnItEUARzEkoDCTJ1",
      "rate": "-8%",
      "audioPath": "/audio/hr/stories/dubrovnik-b1/elevenlabs/player/javit-cu-vam-do-petka-hvala.mp3"
    },
    {
      "speaker": "player",
      "text": "Javit ću vam prošlog petka.",
      "voice": "eqAqnItEUARzEkoDCTJ1",
      "rate": "-8%",
      "audioPath": "/audio/hr/stories/dubrovnik-b1/elevenlabs/player/javit-cu-vam-proslog-petka.mp3"
    },
    {
      "speaker": "player",
      "text": "Je li istina da su ovdje snimali seriju?",
      "voice": "eqAqnItEUARzEkoDCTJ1",
      "rate": "-8%",
      "audioPath": "/audio/hr/stories/dubrovnik-b1/elevenlabs/player/je-li-istina-da-su-ovdje-snimali-seriju.mp3"
    },
    {
      "speaker": "player",
      "text": "kako bi bilo da",
      "voice": "eqAqnItEUARzEkoDCTJ1",
      "rate": "-8%",
      "audioPath": "/audio/hr/stories/dubrovnik-b1/elevenlabs/player/kako-bi-bilo-da.mp3"
    },
    {
      "speaker": "player",
      "text": "Kako bi bilo da poslije predstave odemo na večeru?",
