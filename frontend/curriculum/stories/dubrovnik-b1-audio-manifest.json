    },
    {
      "speaker": "player",
      "text": "s jedne strane",
      "voice": "eqAqnItEUARzEkoDCTJ1",
      "rate": "-8%",
      "audioPath": "/audio/hr/stories/dubrovnik-b1/elevenlabs/player/s-jedne-strane.mp3"
    },
    {
      "speaker": "player",
      "text": "S jedne strane, niže cijene privlače goste, ali s druge strane, kvaliteta nam je važnija.",
      "voice": "eqAqnItEUARzEkoDCTJ1",
      "rate": "-8%",
      "audioPath": "/audio/hr/stories/dubrovnik-b1/elevenlabs/player/s-jedne-strane-nize-cijene-privlace-goste-ali-s-druge-strane.mp3"
    },
    {
      "speaker": "player",
      "text": "savjet",
      "voice": "eqAqnItEUARzEkoDCTJ1",
      "rate": "-8%",
      "audioPath": "/audio/hr/stories/dubrovnik-b1/elevenlabs/player/savjet.mp3"
    },
    {
      "speaker": "player",
      "text": "sezona",
      "voice": "eqAqnItEUARzEkoDCTJ1",
      "rate": "-8%",
      "audioPath": "/audio/hr/stories/dubrovnik-b1/elevenlabs/player/sezona.mp3"
    },
    {
      "speaker": "player",
      "text": "Slažem se — povijest je zanimljivija od serija.",
      "voice": "eqAqnItEUARzEkoDCTJ1",
      "rate": "-8%",
      "audioPath": "/audio/hr/stories/dubrovnik-b1/elevenlabs/player/slazem-se-povijest-je-zanimljivija-od-serija.mp3"
    },
    {
      "speaker": "player",
      "text": "stizati",
      "voice": "eqAqnItEUARzEkoDCTJ1",
      "rate": "-8%",
      "audioPath": "/audio/hr/stories/dubrovnik-b1/elevenlabs/player/stizati.mp3"
    },
    {
      "speaker": "player",
      "text": "Što je bolje za obitelji s djecom?",
      "voice": "eqAqnItEUARzEkoDCTJ1",
      "rate": "-8%",
      "audioPath": "/audio/hr/stories/dubrovnik-b1/elevenlabs/player/sto-je-bolje-za-obitelji-s-djecom.mp3"
    },
    {
      "speaker": "player",
      "text": "Što je dobar za obitelji s djecom?",
      "voice": "eqAqnItEUARzEkoDCTJ1",
      "rate": "-8%",
      "audioPath": "/audio/hr/stories/dubrovnik-b1/elevenlabs/player/sto-je-dobar-za-obitelji-s-djecom.mp3"
    },
    {
      "speaker": "player",
      "text": "stoljeće",
      "voice": "eqAqnItEUARzEkoDCTJ1",
      "rate": "-8%",
      "audioPath": "/audio/hr/stories/dubrovnik-b1/elevenlabs/player/stoljece.mp3"
    },
    {
      "speaker": "player",
      "text": "timski rad",
      "voice": "eqAqnItEUARzEkoDCTJ1",
      "rate": "-8%",
      "audioPath": "/audio/hr/stories/dubrovnik-b1/elevenlabs/player/timski-rad.mp3"
    },
    {
      "speaker": "player",
      "text": "Tko piše zapisnik?",
      "voice": "eqAqnItEUARzEkoDCTJ1",
      "rate": "-8%",
      "audioPath": "/audio/hr/stories/dubrovnik-b1/elevenlabs/player/tko-pise-zapisnik.mp3"
    },
    {
      "speaker": "player",
      "text": "U redu, tri dana bez plaže. Hvala na savjetu!",
      "voice": "eqAqnItEUARzEkoDCTJ1",
      "rate": "-8%",
      "audioPath": "/audio/hr/stories/dubrovnik-b1/elevenlabs/player/u-redu-tri-dana-bez-plaze-hvala-na-savjetu.mp3"
    },
    {
      "speaker": "player",
      "text": "U redu, tri dana na plaži. Hvala!",
      "voice": "eqAqnItEUARzEkoDCTJ1",
      "rate": "-8%",
      "audioPath": "/audio/hr/stories/dubrovnik-b1/elevenlabs/player/u-redu-tri-dana-na-plazi-hvala.mp3"
    },
    {
      "speaker": "player",
      "text": "usporediti",
      "voice": "eqAqnItEUARzEkoDCTJ1",
      "rate": "-8%",
      "audioPath": "/audio/hr/stories/dubrovnik-b1/elevenlabs/player/usporediti.mp3"
    },
    {
      "speaker": "player",
      "text": "Uzet ćemo Elafite, jer su mirniji.",
      "voice": "eqAqnItEUARzEkoDCTJ1",
      "rate": "-8%",
      "audioPath": "/audio/hr/stories/dubrovnik-b1/elevenlabs/player/uzet-cemo-elafite-jer-su-mirniji.mp3"
    },
    {
      "speaker": "player",
      "text": "vodič",
      "voice": "eqAqnItEUARzEkoDCTJ1",
      "rate": "-8%",
      "audioPath": "/audio/hr/stories/dubrovnik-b1/elevenlabs/player/vodic.mp3"
    },
    {
      "speaker": "player",
      "text": "vrijedi pogledati",
      "voice": "eqAqnItEUARzEkoDCTJ1",
      "rate": "-8%",
      "audioPath": "/audio/hr/stories/dubrovnik-b1/elevenlabs/player/vrijedi-pogledati.mp3"
    },
    {
      "speaker": "player",
      "text": "Za pedeset minuta? Imam vremena.",
      "voice": "eqAqnItEUARzEkoDCTJ1",
      "rate": "-8%",
      "audioPath": "/audio/hr/stories/dubrovnik-b1/elevenlabs/player/za-pedeset-minuta-imam-vremena.mp3"
    },
    {
      "speaker": "player",
      "text": "Za pet minuta? Onda trčim na kiosk!",
      "voice": "eqAqnItEUARzEkoDCTJ1",
      "rate": "-8%",
      "audioPath": "/audio/hr/stories/dubrovnik-b1/elevenlabs/player/za-pet-minuta-onda-trcim-na-kiosk.mp3"
    },
    {
      "speaker": "player",
      "text": "začepljen",
      "voice": "eqAqnItEUARzEkoDCTJ1",
      "rate": "-8%",
      "audioPath": "/audio/hr/stories/dubrovnik-b1/elevenlabs/player/zacepljen.mp3"
    },
    {
      "speaker": "player",
      "text": "zapisnik",
      "voice": "eqAqnItEUARzEkoDCTJ1",
      "rate": "-8%",
      "audioPath": "/audio/hr/stories/dubrovnik-b1/elevenlabs/player/zapisnik.mp3"
    },
    {
      "speaker": "player",
      "text": "Znači, autobus je besplatan?",
      "voice": "eqAqnItEUARzEkoDCTJ1",
      "rate": "-8%",
      "audioPath": "/audio/hr/stories/dubrovnik-b1/elevenlabs/player/znaci-autobus-je-besplatan.mp3"
    },
    {
      "speaker": "player",
      "text": "Znači, izgrađene su prošle godine?",
      "voice": "eqAqnItEUARzEkoDCTJ1",
      "rate": "-8%",
      "audioPath": "/audio/hr/stories/dubrovnik-b1/elevenlabs/player/znaci-izgradjene-su-prosle-godine.mp3"
    },
    {
      "speaker": "player",
      "text": "Znači, jednu tabletu navečer?",
      "voice": "eqAqnItEUARzEkoDCTJ1",
      "rate": "-8%",
      "audioPath": "/audio/hr/stories/dubrovnik-b1/elevenlabs/player/znaci-jednu-tabletu-navecer.mp3"
    },
    {
      "speaker": "player",
      "text": "Znači, jednu tabletu ujutro, prije posla?",
      "voice": "eqAqnItEUARzEkoDCTJ1",
      "rate": "-8%",
      "audioPath": "/audio/hr/stories/dubrovnik-b1/elevenlabs/player/znaci-jednu-tabletu-ujutro-prije-posla.mp3"
    },
    {
      "speaker": "player",
      "text": "Znači, kartu je bolje kupiti na kiosku?",
      "voice": "eqAqnItEUARzEkoDCTJ1",
      "rate": "-8%",
      "audioPath": "/audio/hr/stories/dubrovnik-b1/elevenlabs/player/znaci-kartu-je-bolje-kupiti-na-kiosku.mp3"
    },
    {
      "speaker": "player",
      "text": "Znači, Lokrum je bliži, a Elafiti su mirniji.",
      "voice": "eqAqnItEUARzEkoDCTJ1",
      "rate": "-8%",
      "audioPath": "/audio/hr/stories/dubrovnik-b1/elevenlabs/player/znaci-lokrum-je-blizi-a-elafiti-su-mirniji.mp3"
    },
    {
      "speaker": "player",
      "text": "Znači, Lokrum je dalji i skuplji.",
      "voice": "eqAqnItEUARzEkoDCTJ1",
      "rate": "-8%",
      "audioPath": "/audio/hr/stories/dubrovnik-b1/elevenlabs/player/znaci-lokrum-je-dalji-i-skuplji.mp3"
    },
    {
      "speaker": "player",
      "text": "Znači, stare su nekoliko stoljeća?",
      "voice": "eqAqnItEUARzEkoDCTJ1",
      "rate": "-8%",
      "audioPath": "/audio/hr/stories/dubrovnik-b1/elevenlabs/player/znaci-stare-su-nekoliko-stoljeca.mp3"
    },
    {
      "speaker": "player",
      "text": "Znači, tri tablete dnevno?",
      "voice": "eqAqnItEUARzEkoDCTJ1",
      "rate": "-8%",
      "audioPath": "/audio/hr/stories/dubrovnik-b1/elevenlabs/player/znaci-tri-tablete-dnevno.mp3"
    },
    {
      "speaker": "player",
      "text": "Znači, vozi samo broj osamnaest?",
      "voice": "eqAqnItEUARzEkoDCTJ1",
      "rate": "-8%",
      "audioPath": "/audio/hr/stories/dubrovnik-b1/elevenlabs/player/znaci-vozi-samo-broj-osamnaest.mp3"
    },
    {
      "speaker": "player",
      "text": "Zvuči zanimljivo. Koji je prvi korak?",
      "voice": "eqAqnItEUARzEkoDCTJ1",
      "rate": "-8%",
      "audioPath": "/audio/hr/stories/dubrovnik-b1/elevenlabs/player/zvuci-zanimljivo-koji-je-prvi-korak.mp3"
    },
    {
      "speaker": "tea",
      "text": "Ajme! Šališ se, nadam se?",
      "voice": "rmUck1qkzTjuEjdC6Cav",
      "rate": "-8%",
      "audioPath": "/audio/hr/stories/dubrovnik-b1/elevenlabs/tea/ajme-salis-se-nadam-se.mp3"
    },
    {
      "speaker": "tea",
      "text": "Dobar argument. Znaš što? Ostanimo prijatelji — bez obzira na to gdje živimo.",
      "voice": "rmUck1qkzTjuEjdC6Cav",
      "rate": "-8%",
      "audioPath": "/audio/hr/stories/dubrovnik-b1/elevenlabs/tea/dobar-argument-znas-sto-ostanimo-prijatelji-bez-obzira-na-to.mp3"
    },
    {
      "speaker": "tea",
      "text": "Dogovoreno! Znam jednu malu konobu iza katedrale.",
      "voice": "rmUck1qkzTjuEjdC6Cav",
      "rate": "-8%",
      "audioPath": "/audio/hr/stories/dubrovnik-b1/elevenlabs/tea/dogovoreno-znam-jednu-malu-konobu-iza-katedrale.mp3"
    },
    {
      "speaker": "tea",
      "text": "Dogovoreno. Sretan put — i do viđenja, Dubrovniče!",
      "voice": "rmUck1qkzTjuEjdC6Cav",
      "rate": "-8%",
      "audioPath": "/audio/hr/stories/dubrovnik-b1/elevenlabs/tea/dogovoreno-sretan-put-i-do-vidjenja-dubrovnice.mp3"
    },
    {
      "speaker": "tea",
      "text": "Ha-ha, uvijek tako skromno! A reci: je li bolje živjeti ovdje ili u velikom gradu?",
      "voice": "rmUck1qkzTjuEjdC6Cav",
      "rate": "-8%",
      "audioPath": "/audio/hr/stories/dubrovnik-b1/elevenlabs/tea/ha-ha-uvijek-tako-skromno-a-reci-je-li-bolje-zivjeti-ovdje-i.mp3"
    },
    {
      "speaker": "tea",
      "text": "Hej! Znaš li da su počele Dubrovačke ljetne igre?",
      "voice": "rmUck1qkzTjuEjdC6Cav",
      "rate": "-8%",
      "audioPath": "/audio/hr/stories/dubrovnik-b1/elevenlabs/tea/hej-znas-li-da-su-pocele-dubrovacke-ljetne-igre.mp3"
    },
    {
      "speaker": "tea",
      "text": "Imamo karte! Nevjerojatno. Ovo će biti događaj ljeta!",
      "voice": "rmUck1qkzTjuEjdC6Cav",
      "rate": "-8%",
      "audioPath": "/audio/hr/stories/dubrovnik-b1/elevenlabs/tea/imamo-karte-nevjerojatno-ovo-ce-biti-dogadjaj-ljeta.mp3"
    },
    {
      "speaker": "tea",
      "text": "Jesmo? Ja govorim o budućnosti!",
      "voice": "rmUck1qkzTjuEjdC6Cav",
      "rate": "-8%",
      "audioPath": "/audio/hr/stories/dubrovnik-b1/elevenlabs/tea/jesmo-ja-govorim-o-buducnosti.mp3"
    },
    {
      "speaker": "tea",
      "text": "Jučer? Ha-ha, kad bi to bilo moguće!",
      "voice": "rmUck1qkzTjuEjdC6Cav",
      "rate": "-8%",
      "audioPath": "/audio/hr/stories/dubrovnik-b1/elevenlabs/tea/jucer-ha-ha-kad-bi-to-bilo-moguce.mp3"
    },
    {
      "speaker": "tea",
      "text": "Molim? Gdje ima karata?",
      "voice": "rmUck1qkzTjuEjdC6Cav",
      "rate": "-8%",
      "audioPath": "/audio/hr/stories/dubrovnik-b1/elevenlabs/tea/molim-gdje-ima-karata.mp3"
    },
    {
      "speaker": "tea",
      "text": "Molim? Vraćaš se? Kada?",
      "voice": "rmUck1qkzTjuEjdC6Cav",
      "rate": "-8%",
      "audioPath": "/audio/hr/stories/dubrovnik-b1/elevenlabs/tea/molim-vracas-se-kada.mp3"
    },
    {
      "speaker": "tea",
      "text": "Ne mogu vjerovati da sutra odlaziš. Kakvo je bilo ovo ljeto?",
      "voice": "rmUck1qkzTjuEjdC6Cav",
      "rate": "-8%",
      "audioPath": "/audio/hr/stories/dubrovnik-b1/elevenlabs/tea/ne-mogu-vjerovati-da-sutra-odlazis-kakvo-je-bilo-ovo-ljeto.mp3"
    },
    {
      "speaker": "tea",
      "text": "Ni mi tebe. A što ćeš raditi kad se vratiš kući?",
      "voice": "rmUck1qkzTjuEjdC6Cav",
      "rate": "-8%",
      "audioPath": "/audio/hr/stories/dubrovnik-b1/elevenlabs/tea/ni-mi-tebe-a-sto-ces-raditi-kad-se-vratis-kuci.mp3"
    },
    {
      "speaker": "tea",
      "text": "Pametno! Idemo sutra ujutro na blagajnu?",
      "voice": "rmUck1qkzTjuEjdC6Cav",
      "rate": "-8%",
      "audioPath": "/audio/hr/stories/dubrovnik-b1/elevenlabs/tea/pametno-idemo-sutra-ujutro-na-blagajnu.mp3"
    },
    {
      "speaker": "tea",
      "text": "Prošle godine? Ne — počele su jučer!",
      "voice": "rmUck1qkzTjuEjdC6Cav",
      "rate": "-8%",
      "audioPath": "/audio/hr/stories/dubrovnik-b1/elevenlabs/tea/prosle-godine-ne-pocele-su-jucer.mp3"
    },
    {
      "speaker": "tea",
      "text": "Stvarno? Super! Vesna kaže da je tvoja prezentacija bila najbolja ove godine.",
      "voice": "rmUck1qkzTjuEjdC6Cav",
      "rate": "-8%",
      "audioPath": "/audio/hr/stories/dubrovnik-b1/elevenlabs/tea/stvarno-super-vesna-kaze-da-je-tvoja-prezentacija-bila-najbo.mp3"
    },
    {
      "speaker": "tea",
      "text": "U subotu je premijera Hamleta na tvrđavi Lovrijenac! Navodno su karte već rasprodane.",
      "voice": "rmUck1qkzTjuEjdC6Cav",
      "rate": "-8%",
      "audioPath": "/audio/hr/stories/dubrovnik-b1/elevenlabs/tea/u-subotu-je-premijera-hamleta-na-tvrdjavi-lovrijenac-navodno.mp3"
    },
    {
      "speaker": "tea",
      "text": "Već sutra? Hej, to nije baš lijepo!",
      "voice": "rmUck1qkzTjuEjdC6Cav",
      "rate": "-8%",
      "audioPath": "/audio/hr/stories/dubrovnik-b1/elevenlabs/tea/vec-sutra-hej-to-nije-bas-lijepo.mp3"
    },
    {
      "speaker": "vesna",
      "text": "Dobar argument. Dogovoreno je: cijene ostaju iste.",
      "voice": "7IVTG9LKLYndnFiFDLU2",
      "rate": "-8%",
      "audioPath": "/audio/hr/stories/dubrovnik-b1/elevenlabs/vesna/dobar-argument-dogovoreno-je-cijene-ostaju-iste.mp3"
    },
    {
      "speaker": "vesna",
      "text": "Dobro jutro svima! Imamo novog klijenta: hotel na Lapadu želi izlete za svoje goste. Rok je kraj mjeseca.",
      "voice": "7IVTG9LKLYndnFiFDLU2",
      "rate": "-8%",
      "audioPath": "/audio/hr/stories/dubrovnik-b1/elevenlabs/vesna/dobro-jutro-svima-imamo-novog-klijenta-hotel-na-lapadu-zeli.mp3"
    },
    {
      "speaker": "vesna",
      "text": "Dobro pitanje — vi ste novi, pa ćete ga danas pisati vi! Ha-ha.",
      "voice": "7IVTG9LKLYndnFiFDLU2",
      "rate": "-8%",
      "audioPath": "/audio/hr/stories/dubrovnik-b1/elevenlabs/vesna/dobro-pitanje-vi-ste-novi-pa-cete-ga-danas-pisati-vi-ha-ha.mp3"
    },
    {
      "speaker": "vesna",
      "text": "Hm, to baš nema smisla. Možete li ponovno?",
      "voice": "7IVTG9LKLYndnFiFDLU2",
      "rate": "-8%",
      "audioPath": "/audio/hr/stories/dubrovnik-b1/elevenlabs/vesna/hm-to-bas-nema-smisla-mozete-li-ponovno.mp3"
    },
    {
      "speaker": "vesna",
      "text": "Molim? Do kada?",
      "voice": "7IVTG9LKLYndnFiFDLU2",
      "rate": "-8%",
      "audioPath": "/audio/hr/stories/dubrovnik-b1/elevenlabs/vesna/molim-do-kada.mp3"
    },
    {
      "speaker": "vesna",
      "text": "Odlično, hvala! Još jedno pitanje: konkurencija je jeftinija. Trebamo li sniziti cijene?",
      "voice": "7IVTG9LKLYndnFiFDLU2",
      "rate": "-8%",
      "audioPath": "/audio/hr/stories/dubrovnik-b1/elevenlabs/vesna/odlicno-hvala-jos-jedno-pitanje-konkurencija-je-jeftinija-tr.mp3"
    },
    {
      "speaker": "vesna",
      "text": "Pauza? Sastanak je tek počeo!",
      "voice": "7IVTG9LKLYndnFiFDLU2",
      "rate": "-8%",
      "audioPath": "/audio/hr/stories/dubrovnik-b1/elevenlabs/vesna/pauza-sastanak-je-tek-poceo.mp3"
    },
    {
      "speaker": "vesna",
      "text": "Prekjučer? Ha-ha, to bi bilo čudo!",
      "voice": "7IVTG9LKLYndnFiFDLU2",
      "rate": "-8%",
      "audioPath": "/audio/hr/stories/dubrovnik-b1/elevenlabs/vesna/prekjucer-ha-ha-to-bi-bilo-cudo.mp3"
    },
    {
      "speaker": "vesna",
      "text": "Prvo trebamo prezentaciju za klijenta. Tko bi je mogao pripremiti?",
      "voice": "7IVTG9LKLYndnFiFDLU2",
      "rate": "-8%",
      "audioPath": "/audio/hr/stories/dubrovnik-b1/elevenlabs/vesna/prvo-trebamo-prezentaciju-za-klijenta-tko-bi-je-mogao-pripre.mp3"
    },
    {
      "speaker": "vesna",
      "text": "Super. Timski rad, to volim! Sretno svima!",
      "voice": "7IVTG9LKLYndnFiFDLU2",
      "rate": "-8%",
      "audioPath": "/audio/hr/stories/dubrovnik-b1/elevenlabs/vesna/super-timski-rad-to-volim-sretno-svima.mp3"
    }
  ]
}
