  "items": [
    {
      "speaker": "ana",
      "text": "A šećer?",
      "voice": "4vkn1E85GfXGoH86xgU7",
      "rate": "-8%",
      "audioPath": "/audio/hr/stories/split-a1/elevenlabs/ana/a-secer.mp3"
    },
    {
      "speaker": "ana",
      "text": "Ah, kavu! Nema problema.",
      "voice": "4vkn1E85GfXGoH86xgU7",
      "rate": "-8%",
      "audioPath": "/audio/hr/stories/split-a1/elevenlabs/ana/ah-kavu-nema-problema.mp3"
    },
    {
      "speaker": "ana",
      "text": "Čekajte! Što želite? Čaj ili kavu?",
      "voice": "4vkn1E85GfXGoH86xgU7",
      "rate": "-8%",
      "audioPath": "/audio/hr/stories/split-a1/elevenlabs/ana/cekajte-sto-zelite-caj-ili-kavu.mp3"
    },
    {
      "speaker": "ana",
      "text": "Dobro jutro!",
      "voice": "4vkn1E85GfXGoH86xgU7",
      "rate": "-8%",
      "audioPath": "/audio/hr/stories/split-a1/elevenlabs/ana/dobro-jutro.mp3"
    },
    {
      "speaker": "ana",
      "text": "Doviđenja! Vidimo se sutra!",
      "voice": "4vkn1E85GfXGoH86xgU7",
      "rate": "-8%",
      "audioPath": "/audio/hr/stories/split-a1/elevenlabs/ana/dovidjenja-vidimo-se-sutra.mp3"
    },
    {
      "speaker": "ana",
      "text": "Ha-ha! S mlijekom ili bez mlijeka?",
      "voice": "4vkn1E85GfXGoH86xgU7",
      "rate": "-8%",
      "audioPath": "/audio/hr/stories/split-a1/elevenlabs/ana/ha-ha-s-mlijekom-ili-bez-mlijeka.mp3"
    },
    {
      "speaker": "ana",
      "text": "Hvala! Evo, dva eura i pedeset centi.",
      "voice": "4vkn1E85GfXGoH86xgU7",
      "rate": "-8%",
      "audioPath": "/audio/hr/stories/split-a1/elevenlabs/ana/hvala-evo-dva-eura-i-pedeset-centi.mp3"
    },
    {
      "speaker": "ana",
      "text": "Izvolite: bijela kava bez šećera.",
      "voice": "4vkn1E85GfXGoH86xgU7",
      "rate": "-8%",
      "audioPath": "/audio/hr/stories/split-a1/elevenlabs/ana/izvolite-bijela-kava-bez-secera.mp3"
    },
    {
      "speaker": "ana",
      "text": "Izvolite: kava bez šećera.",
      "voice": "4vkn1E85GfXGoH86xgU7",
      "rate": "-8%",
      "audioPath": "/audio/hr/stories/split-a1/elevenlabs/ana/izvolite-kava-bez-secera.mp3"
    },
    {
      "speaker": "ana",
      "text": "Izvolite.",
      "voice": "4vkn1E85GfXGoH86xgU7",
      "rate": "-8%",
      "audioPath": "/audio/hr/stories/split-a1/elevenlabs/ana/izvolite.mp3"
    },
    {
      "speaker": "ana",
      "text": "Jedan čaj, može!",
      "voice": "4vkn1E85GfXGoH86xgU7",
      "rate": "-8%",
      "audioPath": "/audio/hr/stories/split-a1/elevenlabs/ana/jedan-caj-moze.mp3"
    },
    {
      "speaker": "ana",
      "text": "Još nešto?",
      "voice": "4vkn1E85GfXGoH86xgU7",
      "rate": "-8%",
      "audioPath": "/audio/hr/stories/split-a1/elevenlabs/ana/jos-nesto.mp3"
    },
    {
      "speaker": "ana",
      "text": "Kava je dva eura i pedeset centi. Voda je besplatna.",
      "voice": "4vkn1E85GfXGoH86xgU7",
      "rate": "-8%",
      "audioPath": "/audio/hr/stories/split-a1/elevenlabs/ana/kava-je-dva-eura-i-pedeset-centi-voda-je-besplatna.mp3"
    },
    {
      "speaker": "ana",
      "text": "Molim?",
      "voice": "4vkn1E85GfXGoH86xgU7",
      "rate": "-8%",
      "audioPath": "/audio/hr/stories/split-a1/elevenlabs/ana/molim.mp3"
    },
    {
      "speaker": "ana",
      "text": "Molim? Jednu kavu?",
      "voice": "4vkn1E85GfXGoH86xgU7",
      "rate": "-8%",
      "audioPath": "/audio/hr/stories/split-a1/elevenlabs/ana/molim-jednu-kavu.mp3"
    },
    {
      "speaker": "ana",
      "text": "Molim? Karticom ili gotovinom?",
      "voice": "4vkn1E85GfXGoH86xgU7",
      "rate": "-8%",
      "audioPath": "/audio/hr/stories/split-a1/elevenlabs/ana/molim-karticom-ili-gotovinom.mp3"
    },
    {
      "speaker": "ana",
      "text": "Molim? Šećer — da ili ne?",
      "voice": "4vkn1E85GfXGoH86xgU7",
      "rate": "-8%",
      "audioPath": "/audio/hr/stories/split-a1/elevenlabs/ana/molim-secer-da-ili-ne.mp3"
    },
    {
      "speaker": "ana",
      "text": "Naravno! Izvolite.",
      "voice": "4vkn1E85GfXGoH86xgU7",
      "rate": "-8%",
      "audioPath": "/audio/hr/stories/split-a1/elevenlabs/ana/naravno-izvolite.mp3"
    },
    {
      "speaker": "ana",
      "text": "Naravno.",
      "voice": "4vkn1E85GfXGoH86xgU7",
      "rate": "-8%",
      "audioPath": "/audio/hr/stories/split-a1/elevenlabs/ana/naravno.mp3"
    },
    {
      "speaker": "ana",
      "text": "Ne — dva eura i pedeset centi.",
      "voice": "4vkn1E85GfXGoH86xgU7",
      "rate": "-8%",
      "audioPath": "/audio/hr/stories/split-a1/elevenlabs/ana/ne-dva-eura-i-pedeset-centi.mp3"
    },
    {
      "speaker": "ana",
      "text": "Ne, ne — dva eura i pedeset centi!",
      "voice": "4vkn1E85GfXGoH86xgU7",
      "rate": "-8%",
      "audioPath": "/audio/hr/stories/split-a1/elevenlabs/ana/ne-ne-dva-eura-i-pedeset-centi.mp3"
    },
    {
      "speaker": "ana",
      "text": "Pedeset? To je puno!",
      "voice": "4vkn1E85GfXGoH86xgU7",
      "rate": "-8%",
      "audioPath": "/audio/hr/stories/split-a1/elevenlabs/ana/pedeset-to-je-puno.mp3"
    },
    {
      "speaker": "ana",
      "text": "S mlijekom ili bez?",
      "voice": "4vkn1E85GfXGoH86xgU7",
      "rate": "-8%",
      "audioPath": "/audio/hr/stories/split-a1/elevenlabs/ana/s-mlijekom-ili-bez.mp3"
    },
    {
      "speaker": "ivana",
      "text": "Aha… A što trebate?",
      "voice": "FXlzTee7Zx2caYKIAwBF",
      "rate": "-12%",
      "audioPath": "/audio/hr/stories/split-a1/elevenlabs/ivana/aha-a-sto-trebate.mp3"
    },
    {
      "speaker": "ivana",
      "text": "Dobar dan! Izvolite.",
      "voice": "FXlzTee7Zx2caYKIAwBF",
      "rate": "-12%",
      "audioPath": "/audio/hr/stories/split-a1/elevenlabs/ivana/dobar-dan-izvolite.mp3"
    },
    {
      "speaker": "ivana",
      "text": "Hvala! Doviđenja i ugodan dan!",
      "voice": "FXlzTee7Zx2caYKIAwBF",
      "rate": "-12%",
      "audioPath": "/audio/hr/stories/split-a1/elevenlabs/ivana/hvala-dovidjenja-i-ugodan-dan.mp3"
    },
    {
      "speaker": "ivana",
      "text": "Imamo! Svjež kruh je ovdje.",
      "voice": "FXlzTee7Zx2caYKIAwBF",
      "rate": "-12%",
      "audioPath": "/audio/hr/stories/split-a1/elevenlabs/ivana/imamo-svjez-kruh-je-ovdje.mp3"
    },
    {
      "speaker": "ivana",
      "text": "Još nešto?",
      "voice": "FXlzTee7Zx2caYKIAwBF",
      "rate": "-12%",
      "audioPath": "/audio/hr/stories/split-a1/elevenlabs/ivana/jos-nesto.mp3"
    },
    {
      "speaker": "ivana",
      "text": "Mlijeko je ovdje, a voda je tamo.",
      "voice": "FXlzTee7Zx2caYKIAwBF",
      "rate": "-12%",
      "audioPath": "/audio/hr/stories/split-a1/elevenlabs/ivana/mlijeko-je-ovdje-a-voda-je-tamo.mp3"
    },
    {
      "speaker": "ivana",
      "text": "Molim? Mlijeko? Vodu?",
      "voice": "FXlzTee7Zx2caYKIAwBF",
      "rate": "-12%",
      "audioPath": "/audio/hr/stories/split-a1/elevenlabs/ivana/molim-mlijeko-vodu.mp3"
    },
    {
      "speaker": "ivana",
      "text": "Ne — pet eura i deset centi.",
      "voice": "FXlzTee7Zx2caYKIAwBF",
      "rate": "-12%",
      "audioPath": "/audio/hr/stories/split-a1/elevenlabs/ivana/ne-pet-eura-i-deset-centi.mp3"
    },
    {
      "speaker": "ivana",
      "text": "Ne — samo pet eura.",
      "voice": "FXlzTee7Zx2caYKIAwBF",
      "rate": "-12%",
      "audioPath": "/audio/hr/stories/split-a1/elevenlabs/ivana/ne-samo-pet-eura.mp3"
    },
    {
      "speaker": "ivana",
      "text": "Što još trebate?",
      "voice": "FXlzTee7Zx2caYKIAwBF",
      "rate": "-12%",
      "audioPath": "/audio/hr/stories/split-a1/elevenlabs/ivana/sto-jos-trebate.mp3"
    },
    {
      "speaker": "ivana",
      "text": "To je pet eura i deset centi.",
      "voice": "FXlzTee7Zx2caYKIAwBF",
      "rate": "-12%",
      "audioPath": "/audio/hr/stories/split-a1/elevenlabs/ivana/to-je-pet-eura-i-deset-centi.mp3"
    },
    {
      "speaker": "ivana",
      "text": "To je pet eura.",
      "voice": "FXlzTee7Zx2caYKIAwBF",
      "rate": "-12%",
      "audioPath": "/audio/hr/stories/split-a1/elevenlabs/ivana/to-je-pet-eura.mp3"
    },
    {
      "speaker": "ivana",
      "text": "Trebate li vrećicu?",
      "voice": "FXlzTee7Zx2caYKIAwBF",
      "rate": "-12%",
      "audioPath": "/audio/hr/stories/split-a1/elevenlabs/ivana/trebate-li-vrecicu.mp3"
    },
    {
      "speaker": "marko",
      "text": "Apartman je broj sedam, na drugom katu.",
      "voice": "jJ1MUnCKtrOI23TlUUHc",
      "rate": "-8%",
      "audioPath": "/audio/hr/stories/split-a1/elevenlabs/marko/apartman-je-broj-sedam-na-drugom-katu.mp3"
    },
    {
      "speaker": "marko",
      "text": "Bok! Kako si?",
      "voice": "jJ1MUnCKtrOI23TlUUHc",
      "rate": "-8%",
      "audioPath": "/audio/hr/stories/split-a1/elevenlabs/marko/bok-kako-si.mp3"
    },
    {
      "speaker": "marko",
      "text": "Dobar dan! Dobro došli u Split!",
      "voice": "jJ1MUnCKtrOI23TlUUHc",
      "rate": "-8%",
      "audioPath": "/audio/hr/stories/split-a1/elevenlabs/marko/dobar-dan-dobro-dosli-u-split.mp3"
    },
    {
      "speaker": "marko",
      "text": "Doviđenja? Ne, ne! Dobro došli!",
      "voice": "jJ1MUnCKtrOI23TlUUHc",
      "rate": "-8%",
      "audioPath": "/audio/hr/stories/split-a1/elevenlabs/marko/dovidjenja-ne-ne-dobro-dosli.mp3"
    },
    {
      "speaker": "marko",
      "text": "Drago mi je! Odakle si?",
      "voice": "jJ1MUnCKtrOI23TlUUHc",
      "rate": "-8%",
      "audioPath": "/audio/hr/stories/split-a1/elevenlabs/marko/drago-mi-je-odakle-si.mp3"
    },
    {
      "speaker": "marko",
      "text": "Evo! Ovo je ključ od apartmana.",
      "voice": "jJ1MUnCKtrOI23TlUUHc",
      "rate": "-8%",
      "audioPath": "/audio/hr/stories/split-a1/elevenlabs/marko/evo-ovo-je-kljuc-od-apartmana.mp3"
    },
    {
      "speaker": "marko",
      "text": "Ha-ha! Dobar dan i tebi. Ali kako si?",
      "voice": "jJ1MUnCKtrOI23TlUUHc",
      "rate": "-8%",
      "audioPath": "/audio/hr/stories/split-a1/elevenlabs/marko/ha-ha-dobar-dan-i-tebi-ali-kako-si.mp3"
    },
    {
      "speaker": "marko",
      "text": "Iz Poljske! Super. Imaš rezervaciju?",
      "voice": "jJ1MUnCKtrOI23TlUUHc",
      "rate": "-8%",
      "audioPath": "/audio/hr/stories/split-a1/elevenlabs/marko/iz-poljske-super-imas-rezervaciju.mp3"
    },
    {
      "speaker": "marko",
      "text": "Ja sam Marko. Kako se zoveš?",
      "voice": "jJ1MUnCKtrOI23TlUUHc",
      "rate": "-8%",
      "audioPath": "/audio/hr/stories/split-a1/elevenlabs/marko/ja-sam-marko-kako-se-zoves.mp3"
    },
    {
      "speaker": "marko",
      "text": "Ključ je kod mene. Vidimo se!",
      "voice": "jJ1MUnCKtrOI23TlUUHc",
      "rate": "-8%",
      "audioPath": "/audio/hr/stories/split-a1/elevenlabs/marko/kljuc-je-kod-mene-vidimo-se.mp3"
    },
    {
      "speaker": "marko",
      "text": "Kupaonica je lijevo.",
      "voice": "jJ1MUnCKtrOI23TlUUHc",
      "rate": "-8%",
      "audioPath": "/audio/hr/stories/split-a1/elevenlabs/marko/kupaonica-je-lijevo.mp3"
    },
    {
      "speaker": "marko",
      "text": "Laku noć? Ali sada je dan!",
      "voice": "jJ1MUnCKtrOI23TlUUHc",
      "rate": "-8%",
      "audioPath": "/audio/hr/stories/split-a1/elevenlabs/marko/laku-noc-ali-sada-je-dan.mp3"
    },
    {
      "speaker": "marko",
      "text": "Molim? Ja se zovem Marko. A ti?",
      "voice": "jJ1MUnCKtrOI23TlUUHc",
      "rate": "-8%",
      "audioPath": "/audio/hr/stories/split-a1/elevenlabs/marko/molim-ja-se-zovem-marko-a-ti.mp3"
    },
    {
      "speaker": "marko",
      "text": "Molim? Ključ? Gdje je ključ?",
      "voice": "jJ1MUnCKtrOI23TlUUHc",
      "rate": "-8%",
      "audioPath": "/audio/hr/stories/split-a1/elevenlabs/marko/molim-kljuc-gdje-je-kljuc.mp3"
    },
    {
      "speaker": "marko",
      "text": "Ne desno — lijevo!",
      "voice": "jJ1MUnCKtrOI23TlUUHc",
      "rate": "-8%",
      "audioPath": "/audio/hr/stories/split-a1/elevenlabs/marko/ne-desno-lijevo.mp3"
    },
    {
      "speaker": "marko",
      "text": "Ne, ne: broj sedam. Sedam!",
      "voice": "jJ1MUnCKtrOI23TlUUHc",
      "rate": "-8%",
      "audioPath": "/audio/hr/stories/split-a1/elevenlabs/marko/ne-ne-broj-sedam-sedam.mp3"
    },
    {
      "speaker": "marko",
      "text": "Ne? Ali ovdje je rezervacija na tvoje ime!",
      "voice": "jJ1MUnCKtrOI23TlUUHc",
      "rate": "-8%",
      "audioPath": "/audio/hr/stories/split-a1/elevenlabs/marko/ne-ali-ovdje-je-rezervacija-na-tvoje-ime.mp3"
    },
    {
      "speaker": "marko",
      "text": "Nema problema. Vidimo se!",
      "voice": "jJ1MUnCKtrOI23TlUUHc",
      "rate": "-8%",
      "audioPath": "/audio/hr/stories/split-a1/elevenlabs/marko/nema-problema-vidimo-se.mp3"
    },
    {
      "speaker": "marko",
      "text": "Odakle? Iz Hrvatske? Iz Poljske?",
      "voice": "jJ1MUnCKtrOI23TlUUHc",
      "rate": "-8%",
      "audioPath": "/audio/hr/stories/split-a1/elevenlabs/marko/odakle-iz-hrvatske-iz-poljske.mp3"
    },
    {
      "speaker": "marko",
      "text": "Odlično! Još nešto: gdje živiš u Poljskoj?",
      "voice": "jJ1MUnCKtrOI23TlUUHc",
      "rate": "-8%",
      "audioPath": "/audio/hr/stories/split-a1/elevenlabs/marko/odlicno-jos-nesto-gdje-zivis-u-poljskoj.mp3"
    },
    {
      "speaker": "marko",
      "text": "Polako: broj — sedam. Sedam!",
      "voice": "jJ1MUnCKtrOI23TlUUHc",
      "rate": "-8%",
      "audioPath": "/audio/hr/stories/split-a1/elevenlabs/marko/polako-broj-sedam-sedam.mp3"
    },
    {
      "speaker": "marko",
      "text": "Polako: kako — se — zoveš? Tvoje ime?",
      "voice": "jJ1MUnCKtrOI23TlUUHc",
      "rate": "-8%",
      "audioPath": "/audio/hr/stories/split-a1/elevenlabs/marko/polako-kako-se-zoves-tvoje-ime.mp3"
    },
    {
      "speaker": "marko",
      "text": "Super! Prijava je gotova.",
      "voice": "jJ1MUnCKtrOI23TlUUHc",
      "rate": "-8%",
      "audioPath": "/audio/hr/stories/split-a1/elevenlabs/marko/super-prijava-je-gotova.mp3"
    },
    {
      "speaker": "marko",
      "text": "Super! Što trebaš?",
      "voice": "jJ1MUnCKtrOI23TlUUHc",
      "rate": "-8%",
      "audioPath": "/audio/hr/stories/split-a1/elevenlabs/marko/super-sto-trebas.mp3"
    },
    {
      "speaker": "marko",
      "text": "Tako je, sedam! Imaš li pitanje?",
      "voice": "jJ1MUnCKtrOI23TlUUHc",
      "rate": "-8%",
      "audioPath": "/audio/hr/stories/split-a1/elevenlabs/marko/tako-je-sedam-imas-li-pitanje.mp3"
    },
    {
      "speaker": "narrator",
      "text": "Apartman. Marko je tu.",
      "voice": "O9XgmQnaZveORWl6mTHm",
      "rate": "-14%",
      "audioPath": "/audio/hr/stories/split-a1/elevenlabs/narrator/apartman-marko-je-tu.mp3"
    },
    {
      "speaker": "narrator",
      "text": "Kafić na rivi. Miriše kava.",
      "voice": "O9XgmQnaZveORWl6mTHm",
      "rate": "-14%",
      "audioPath": "/audio/hr/stories/split-a1/elevenlabs/narrator/kafic-na-rivi-mirise-kava.mp3"
    },
    {
      "speaker": "narrator",
      "text": "Split. Sunce, more i apartman u starom gradu.",
      "voice": "O9XgmQnaZveORWl6mTHm",
      "rate": "-14%",
      "audioPath": "/audio/hr/stories/split-a1/elevenlabs/narrator/split-sunce-more-i-apartman-u-starom-gradu.mp3"
    },
    {
      "speaker": "narrator",
      "text": "Trgovina je blizu apartmana.",
      "voice": "O9XgmQnaZveORWl6mTHm",
      "rate": "-14%",
      "audioPath": "/audio/hr/stories/split-a1/elevenlabs/narrator/trgovina-je-blizu-apartmana.mp3"
    },
    {
      "speaker": "narrator",
      "text": "Vrijeme je za plaćanje.",
      "voice": "O9XgmQnaZveORWl6mTHm",
      "rate": "-14%",
      "audioPath": "/audio/hr/stories/split-a1/elevenlabs/narrator/vrijeme-je-za-placanje.mp3"
    },
    {
      "speaker": "player",
      "text": "apartman",
      "voice": "eqAqnItEUARzEkoDCTJ1",
      "rate": "-8%",
      "audioPath": "/audio/hr/stories/split-a1/elevenlabs/player/apartman.mp3"
    },
    {
      "speaker": "player",
      "text": "Bez mlijeka, hvala.",
      "voice": "eqAqnItEUARzEkoDCTJ1",
      "rate": "-8%",
      "audioPath": "/audio/hr/stories/split-a1/elevenlabs/player/bez-mlijeka-hvala.mp3"
    },
    {
      "speaker": "player",
      "text": "Bez šećera, molim.",
      "voice": "eqAqnItEUARzEkoDCTJ1",
      "rate": "-8%",
      "audioPath": "/audio/hr/stories/split-a1/elevenlabs/player/bez-secera-molim.mp3"
    },
    {
      "speaker": "player",
      "text": "broj",
      "voice": "eqAqnItEUARzEkoDCTJ1",
      "rate": "-8%",
      "audioPath": "/audio/hr/stories/split-a1/elevenlabs/player/broj.mp3"
    },
    {
      "speaker": "player",
      "text": "Broj sedam?",
      "voice": "eqAqnItEUARzEkoDCTJ1",
